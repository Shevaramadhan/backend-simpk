{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "app.ts", "config", "controllers", "middlewares", "routes", "types", "utils", "validators", "prisma/seed.ts", "tests"],
  "exclude": ["node_modules", "dist"]
}
