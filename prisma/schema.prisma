// Skema mengikuti BRS bagian 9.2. Nilai status bersifat usulan dan divalidasi bersama koordinator.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  MARKETING
  OPERASIONAL
  TIM
  KLIEN
}

enum OrderStatus {
  BARU
  DITINJAU
  DISETUJUI
  DITOLAK
  DIBATALKAN
  MENJADI_PROYEK
}

enum ProjectStatus {
  PERSIAPAN
  BERJALAN
  DITUNDA
  SELESAI
  DIBATALKAN
}

enum TaskStatus {
  BELUM_DIKERJAKAN
  DIKERJAKAN
  REVIEW
  SELESAI
}

enum TaskPriority {
  RENDAH
  SEDANG
  TINGGI
}

// Bidang pekerjaan pada tampilan Detail (Figma). Progres bidang = rata-rata berbobot tugas di bidang itu.
enum TaskBidang {
  UI_UX
  FRONTEND
  BACKEND
  INTEGRASI
}

enum InvoiceStatus {
  DRAF
  DITERBITKAN
  LUNAS
}

enum PaymentStatus {
  MENUNGGU_VERIFIKASI
  DITERIMA
  DITOLAK
}

enum NotificationStatus {
  TERTUNDA
  TERKIRIM
  GAGAL
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  /// Keahlian utama anggota Tim (worker), diketik bebas, misalnya "Frontend Developer". Kosong untuk role lain.
  keahlian     String?  @db.VarChar(60)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  client           Client?
  memberships      ProjectMember[]
  assignedTasks    Task[]           @relation("TaskAssignee")
  progressUpdates  ProgressUpdate[]
  verifiedPayments Payment[]        @relation("PaymentVerifier")
  issuedInvoices   Invoice[]        @relation("InvoiceIssuer")
  notifications    Notification[]
  passwordResets   PasswordReset[]

  @@map("users")
}

// Hanya hash token yang disimpan, sehingga isi database tidak dapat dipakai untuk mereset akun.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Client {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique @map("user_id")
  namaInstansi String   @map("nama_instansi") @db.VarChar(160)
  jenisKlien   String   @map("jenis_klien") @db.VarChar(40)
  noWhatsapp   String?  @map("no_whatsapp") @db.VarChar(25)
  alamat       String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders  Order[]
  reviews Review[]

  @@map("clients")
}

model Service {
  id           Int      @id @default(autoincrement())
  nama         String   @db.VarChar(160)
  deskripsi    String   @db.Text
  hargaMin     Decimal  @map("harga_min") @db.Decimal(14, 2)
  hargaMax     Decimal  @map("harga_max") @db.Decimal(14, 2)
  estimasiHari Int      @map("estimasi_hari")
  isVisible    Boolean  @default(true) @map("is_visible")
  createdAt    DateTime @default(now()) @map("created_at")

  portfolios Portfolio[]
  orders     Order[]

  @@map("services")
}

model Portfolio {
  id        Int     @id @default(autoincrement())
  serviceId Int?    @map("service_id")
  judul     String  @db.VarChar(160)
  deskripsi String  @db.Text
  gambar    String? @db.VarChar(255)
  tahun     Int?

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@map("portfolios")
}

model Order {
  id                Int         @id @default(autoincrement())
  nomor             String      @unique @db.VarChar(40)
  // Nama project pada form pengajuan (Figma); tidak ada di ERD, perlu ditambahkan System Analyst.
  judul             String      @default("") @db.VarChar(160)
  clientId          Int         @map("client_id")
  serviceId         Int?        @map("service_id")
  kebutuhan         String      @db.Text
  anggaran          Decimal?    @db.Decimal(14, 2)
  nilaiDisepakati   Decimal?    @map("nilai_disepakati") @db.Decimal(14, 2)
  tenggatDiharapkan DateTime?   @map("tenggat_diharapkan") @db.Date
  status            OrderStatus @default(BARU)
  alasanDitolak     String?     @map("alasan_ditolak") @db.VarChar(255)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service   Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  projects  Project[]
  documents OrderDocument[]
  invoices  Invoice[]

  @@index([clientId])
  @@index([status])
  @@map("orders")
}

// Dokumen pendukung pengajuan. Berkas disimpan di uploads/dokumen dengan nama acak.
model OrderDocument {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  namaFile  String   @map("nama_file") @db.VarChar(255)
  path      String   @db.VarChar(255)
  mime      String   @db.VarChar(100)
  ukuran    Int
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_documents")
}

model Project {
  id            Int           @id @default(autoincrement())
  kode          String        @unique @db.VarChar(40)
  orderId       Int           @map("order_id")
  nama          String        @db.VarChar(160)
  nilai         Decimal       @db.Decimal(14, 2)
  tglMulai      DateTime?     @map("tgl_mulai") @db.Date
  targetSelesai DateTime?     @map("target_selesai") @db.Date
  status        ProjectStatus @default(PERSIAPAN)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  members ProjectMember[]
  tasks   Task[]
  review  Review?

  @@index([orderId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  projectId Int     @map("project_id")
  userId    Int     @map("user_id")
  posisi    String  @db.VarChar(60)
  isPm      Boolean @default(false) @map("is_pm")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id         Int          @id @default(autoincrement())
  projectId  Int          @map("project_id")
  judul      String       @db.VarChar(200)
  deskripsi  String?      @db.Text
  assigneeId Int?         @map("assignee_id")
  tenggat    DateTime?    @db.Date
  prioritas  TaskPriority @default(SEDANG)
  bidang     TaskBidang   @default(FRONTEND)
  bobot      Int          @default(1)
  status     TaskStatus   @default(BELUM_DIKERJAKAN)
  persentase Int          @default(0)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  updates  ProgressUpdate[]

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model ProgressUpdate {
  id            Int      @id @default(autoincrement())
  taskId        Int      @map("task_id")
  authorId      Int      @map("author_id")
  persentase    Int
  catatanTeknis String?  @map("catatan_teknis") @db.Text
  catatanKlien  String?  @map("catatan_klien") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([authorId])
  @@map("progress_updates")
}

// Tagihan milik pesanan (ERD), diterbitkan Marketing setelah pesanan disetujui (BPMN 3, UC-15).
model Invoice {
  id           Int           @id @default(autoincrement())
  nomor        String        @unique @db.VarChar(40)
  orderId      Int           @map("order_id")
  issuedById   Int?          @map("issued_by_id")
  keterangan   String        @db.VarChar(160)
  total        Decimal       @db.Decimal(14, 2)
  tglTerbit    DateTime      @default(now()) @map("tgl_terbit")
  jatuhTempo   DateTime?     @map("jatuh_tempo") @db.Date
  status       InvoiceStatus @default(DITERBITKAN)
  createdAt    DateTime      @default(now()) @map("created_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  issuedBy User?     @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([orderId])
  @@map("invoices")
}

model Payment {
  id               Int           @id @default(autoincrement())
  invoiceId        Int           @map("invoice_id")
  jumlah           Decimal       @db.Decimal(14, 2)
  tglTransfer      DateTime      @map("tgl_transfer") @db.Date
  fileBukti        String        @map("file_bukti") @db.VarChar(255)
  statusVerifikasi PaymentStatus @default(MENUNGGU_VERIFIKASI) @map("status_verifikasi")
  alasanDitolak    String?       @map("alasan_ditolak") @db.VarChar(255)
  verifiedById     Int?          @map("verified_by_id")
  verifiedAt       DateTime?     @map("verified_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  verifiedBy User?   @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([statusVerifikasi])
  @@map("payments")
}

model Review {
  id        Int      @id @default(autoincrement())
  projectId Int      @unique @map("project_id")
  clientId  Int      @map("client_id")
  rating    Int
  komentar  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@map("reviews")
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int                @map("user_id")
  pesan     String             @db.VarChar(500)
  kanal     String             @default("email") @db.VarChar(20)
  status    NotificationStatus @default(TERTUNDA)
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
