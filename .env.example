DATABASE_URL="mysql://root:ganti_kata_sandi_root@127.0.0.1:3306/simpk"
# Minimal 32 karakter acak, lihat README untuk cara membuatnya
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
PORT=4000
# Alamat frontend yang boleh memanggil API, dipisah koma bila lebih dari satu. Produksi: https://nama-proyek.vercel.app
FRONTEND_ORIGIN="http://localhost:5173"
# Isi 1 bila API berada di belakang Nginx (aaPanel); 0 saat pengembangan
TRUST_PROXY=0
# Kata sandi akun contoh saat menjalankan seed
SEED_PASSWORD=""
# Pengirim email lupa kata sandi. Jika SMTP_HOST kosong, tautan tampil di terminal saat pengembangan
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# OAuth Client ID dari Google Cloud Console (jenis Web application). Kosong = login Google tidak aktif
GOOGLE_CLIENT_ID=""
# Dokumentasi API di /api/v1/docs. true hanya di laptop pengembang untuk mencoba endpoint; di VPS biarkan false
DOCS_TRY_IT=false
# Folder berkas unggahan (dokumen pendukung dan bukti transfer)
UPLOAD_DIR="uploads"
